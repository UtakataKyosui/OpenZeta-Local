# ---------------------------------------------------------------------------
# OpenZeta 環境変数
#
# このファイルを .env にコピーして必要な値だけ設定してください:
#   cp .env.example .env
#
# ※ .env は .gitignore 済みです。絶対にコミットしないでください。
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (任意)
#   サーバー側の Gemini キー。設定すると、アプリ内 Settings で
#   API キーを入力しなくてもチャットが動作します。
#   未設定でも、Settings で各自のキー (BYOK) を入力すれば動きます。
#   取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama のサーバー側接続先 (ブラウザには保存しません)。/v1 は省略可能。
# npm run dev: http://localhost:11434
# Docker: http://host.docker.internal:11434 (Compose の既定値)
# Settings の Base URL を /api/ollama、Model Name を取得済みモデル名に設定。
OLLAMA_BASE_URL=

# APP_URL (任意)
#   アプリを公開する URL。自動作成リンクや OAuth コールバック等で使用。
APP_URL=
